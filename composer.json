{
  "name": "padosoft/laravel-ai-act-compliance",
  "description": "AI Act compliance bundle for Laravel AI applications",
  "type": "library",
  "license": "MIT",
  "authors": [
    {"name": "Padosoft"}
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/routing": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Padosoft\\AiActCompliance\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Padosoft\\AiActCompliance\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Padosoft\\AiActCompliance\\AiActComplianceServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
