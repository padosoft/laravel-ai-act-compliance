{
  "title": "laravel-ai-act-compliance",
  "description": "AI Act compliance bundle for Laravel AI applications.",
  "url": "https://doc.laravel-ai-act-compliance.padosoft.com",
  "src": "docs",
  "out": "_site",
  "base": "/",
  "favicon": "/assets/favicon.svg",
  "copyCode": true,
  "pageNavigation": true,
  "minify": true,
  "theme": {
    "appearance": "system",
    "accent": "#0d9488",
    "customCss": [
      "assets/custom.css"
    ]
  },
  "layout": {
    "breadcrumbs": true,
    "sidebar": true,
    "toc": true,
    "footer": {
      "enabled": true
    }
  },
  "footer": {
    "content": "MIT licensed. Maintained by Padosoft.",
    "columns": [
      {
        "title": "Project",
        "links": [
          {
            "label": "GitHub",
            "href": "https://github.com/padosoft/laravel-ai-act-compliance"
          },
          {
            "label": "Packagist",
            "href": "https://packagist.org/packages/padosoft/laravel-ai-act-compliance"
          }
        ]
      }
    ]
  },
  "plugins": {
    "search": {
      "enabled": true,
      "semantic": true,
      "indexDir": ".docmd-search"
    },
    "git": {
      "enabled": true
    },
    "seo": {
      "enabled": true
    },
    "sitemap": {
      "enabled": true
    },
    "mermaid": {
      "enabled": true
    },
    "math": {
      "enabled": true
    },
    "llms": {
      "enabled": true
    },
    "analytics": false
  },
